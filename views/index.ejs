<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class=" text-white main w-full min-h-screen bg-zinc-900">
        <div class="form p-10">
            <form action="/create" method="post">
                <input class="block w-full outline-none px-5 py-5 bg-zinc-700" type="text" placeholder="Title"
                    name="title">
                <textarea class="block w-full outline-none mt-2 resize-none px-5 py-5 bg-zinc-700"
                    placeholder="Wite task" name="details"></textarea>
                <input class="mt-2 bg-green-700 px-5 py-2 rounded-md" type="submit" value="create task">
            </form>
        </div>
        <div class="tasks flex gap-3 flex-wrap p-10">
            <% if (files.length>0){%>
                <% files.forEach(function(val){ %>
                    <div class=" task w-72 px-3 py-4 rounded-md bg-zinc-800">
                        <h1 class=" text-white text-3xl tracking-tighter">
                            <%= val %>
                        </h1>
                        <div class="flex w-full justify-between">
                            <a class="text-blue-500 inline-block " href="/file/<%=val%>">READ MORE</a>
                            <a class="text-zinc-600" href="/edit/<%= val %>">edit</a>
                        </div>
                    </div>

                    <% }) %>
                        <% }else{ %>
                            <h3 class="text-zinc-600">No Tasks</h3>
                            <% }%>



                                <div class=" task w-72 hidden px-3 py-4 rounded-md bg-zinc-800">
                                    <h1 class=" text-white text-3xl tracking-tighter">Some task</h1>
                                    <a class="text-blue-500 inline-block mt-3" href="">READ MORE</a>
                                </div>

        </div>
    </div>
</body>

</html>