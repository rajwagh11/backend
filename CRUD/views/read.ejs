<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>All Users</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">

        <!-- Navigation -->
        <div class="nav mt-5 text-blue-500">
            <a href="/">Home</a>
        </div>

        <!-- Heading -->
        <h1 class="text-3xl tracking-tighter mb-5">
            ALL USERS
        </h1>

        <!-- Users Container -->
        <div class="users flex gap-3 flex-wrap">

            <% if (users.length > 0) { %>

                <% users.forEach(function(user) { %>

                    <!-- User Card -->
                    <div class="user w-72 p-5 bg-zinc-800 rounded-lg">

                        <!-- Profile Image -->
                        <div class="w-full h-72 rounded-lg bg-zinc-700">
                            <img 
                                class="w-full h-full object-cover" 
                                src="<%= user.image %>" 
                                alt="Profile Image"
                            >
                        </div>

                        <!-- User Information -->
                        <h3 class="text-xl mt-3 tracking-tighter">
                            <%= user.name %>
                        </h3>

                        <h5 class="text-zinc-500">
                            <%= user.email %>
                        </h5>

                        <!-- Actions -->
                        <div class="flex gap-4 mt-5">

                            <a 
                                href="/edit/<%= user._id %>" 
                                class="text-zinc-400 hover:text-white"
                            >
                                Edit User
                            </a>

                            <a 
                                href="/delete/<%= user._id %>" 
                                class="text-red-500 hover:text-red-400"
                            >
                                Delete User
                            </a>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <!-- No Users -->
                <h3>No users yet</h3>

            <% } %>

        </div>

    </div>

</body>

</html>